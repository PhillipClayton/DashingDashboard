# Server
PORT=3001
# Listen on all network interfaces so phones and other computers on your LAN can connect.
HOST=0.0.0.0
DATA_DIR=./data

# Admin auth (required to edit To Do and Shopping lists)
ADMIN_PASSWORD=your_secure_password_here
# Optional; use a long random value in production.
ADMIN_SESSION_SECRET=optional_random_string_for_signing_jwts

# Weather location (latitude/longitude)
WEATHER_LAT=37.7749
WEATHER_LON=-122.4194
